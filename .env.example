# Salin ke .env.local untuk pengembangan, atau isi sebagai Environment Variable
# di hPanel (Websites, domain, Deployment, Variabel environment).
# Untuk hPanel pakai hostinger/fantasea-hpanel.env (tombol Impor .env), lalu isi value-nya.
# Value "-" dibaca sama dengan kosong (lib/env.ts).

# Alamat situs untuk sitemap dan pratinjau tautan. Dibaca saat aplikasi jalan.
SITE_URL=https://fantaseadivetravel.com

# Kunci penyiapan, tulis sendiri (panjang dan acak). Dipakai untuk membuat
# akun pemilik pertama di /admin, dan untuk Lupa kata sandi pemilik selama
# email sistem belum dipasang. Bukan kata sandi masuk. Simpan, jangan dihapus.
FANTASEA_KUNCI=

# Folder data (isi situs, permintaan tamu, akun, foto unggahan).
# Kosong berarti ~/.fantasea-data di folder home hosting, di luar folder aplikasi.
FANTASEA_DATA_DIR=

# Email sistem untuk kode Lupa kata sandi (SMTP). Semua kosong berarti belum
# dipasang. Email Hostinger memakai smtp.hostinger.com port 465, user alamat
# email lengkap, dan sandi kotak email itu. EMAIL_DARI kosong berarti SMTP_USER.
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
EMAIL_DARI=

# Diisi Hostinger otomatis. Jangan diisi manual.
# PORT=3000
